#!/usr/bin/env bash
# Mica pre-commit hook: format + lint before every commit.
# Enable for this repo with:  git config core.hooksPath .githooks
#
# Behavior:
#  1. cargo fmt --all                  -> auto-formats and re-stages changes
#  2. cargo clippy --all-targets -- -D warnings   -> blocks on any warning
#
# Skip (only when you know why):  git commit --no-verify
set -euo pipefail

# Only run if the staged change touches Rust files or Cargo metadata.
if ! git diff --cached --name-only --diff-filter=ACMR | grep -E '\.rs$|^Cargo\.(toml|lock)$' > /dev/null; then
    exit 0
fi

# Need cargo on PATH.
if ! command -v cargo > /dev/null; then
    echo "pre-commit: cargo not found on PATH; skipping fmt + clippy" >&2
    exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "pre-commit: cargo fmt --all"
cargo fmt --all

# Re-stage anything fmt rewrote that was already staged.
STAGED_RS=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.rs$' || true)
if [ -n "$STAGED_RS" ]; then
    # shellcheck disable=SC2086
    git add $STAGED_RS
fi

echo "pre-commit: cargo clippy --all-targets -- -D warnings"
cargo clippy --all-targets --quiet -- -D warnings

echo "pre-commit: ok"
