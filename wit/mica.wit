// mica's plugin contract (P5.2). Plugins compile to wasm32-wasip2
// components and implement these worlds. Capabilities (HTTP client,
// file write, env access) are imports the host can grant or deny per
// `--plugin-grants <name>=<caps>`.
//
// Versioning: the package name carries a major-version suffix; mica
// only loads plugins whose component matches the running mica's
// supported package set. Future major versions live alongside this
// file so plugins built once can run against multiple mica releases.

package mica:plugin@0.1.0;

interface lifecycle {
    /// One-shot at plugin load. Plugins do their own setup here.
    init: func() -> result<_, string>;

    /// One-shot at orchestrator shutdown. Best-effort.
    shutdown: func();
}

interface session {
    /// W3C-shaped capabilities the orchestrator received from the
    /// client, serialized as JSON.
    record session-info {
        request-id: string,
        browser-name: string,
        browser-version: string,
        capabilities-json: string,
    }

    /// Called before mica.create-session forwards to the upstream.
    /// A plugin can return modified capabilities-json (e.g. inject
    /// tenant headers) or reject the session by returning an error.
    on-create: func(info: session-info) -> result<string, string>;

    /// Called after the session is fully torn down (idle / DELETE /
    /// shutdown). started + finished are unix epoch milliseconds.
    on-end: func(session-id: string, started: u64, finished: u64);
}

interface artifact {
    record file-info {
        path: string,
        session-id: string,
        kind: artifact-kind,
        size-bytes: u64,
    }

    enum artifact-kind {
        video,
        log,
    }

    /// Called for every FileCreated event. Plugin returns the
    /// destination URI it uploaded to, or an error to surface in
    /// mica's logs.
    on-file-created: func(info: file-info) -> result<string, string>;
}

interface http {
    record request {
        method: string,
        url: string,
        headers: list<tuple<string, string>>,
        body: list<u8>,
    }

    record response {
        status: u16,
        headers: list<tuple<string, string>>,
        body: list<u8>,
    }

    /// Optional middleware: rewrite a request before it leaves mica.
    intercept-request: func(req: request) -> result<request, string>;

    /// Optional middleware: rewrite a response before it returns to
    /// the client.
    intercept-response: func(resp: response) -> result<response, string>;
}

world mica-plugin {
    export lifecycle;
    export session;
    export artifact;
    export http;
}
